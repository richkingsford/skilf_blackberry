# Copy to .env.local for local smoke tests. Do not commit real secrets.

# Firebase Admin: use either the single JSON value or the split values below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=skilf-9f736
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Role administration. Generate with: npm run production:admin-token
ADMIN_ROLE_TOKEN=

# Deferred payment batch: only needed when Stripe Checkout goes live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email notifications for signed-in user messages.
RESEND_API_KEY=
MESSAGE_TO_EMAIL=richkingsford@gmail.com
MESSAGE_FROM_EMAIL=Skilf <sender@your-verified-domain.example>

# Firebase web API fallback used by the lightweight email function verifier.
FIREBASE_WEB_API_KEY=

# Production writes should be true only for production or intentional local testing.
SKILF_ALLOW_WRITES=false
